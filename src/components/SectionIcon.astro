---
/**
 * トップページの h2 見出しに添える線画アイコン。
 * Markdown 見出し内に <SectionIcon name="..." /> の形で置く。
 * アイコンは Lucide (https://lucide.dev, ISC License) のパスを利用。
 */
type IconName = 'fingerprint' | 'shield-check' | 'lock' | 'clipboard-check';

interface Props {
  name: IconName;
}

const { name } = Astro.props;

const ICONS: Record<IconName, string> = {
  // 認証：誰がログインできるか
  fingerprint: `
    <path d="M2 12C2 6.5 6.5 2 12 2a10 10 0 0 1 8 4"/>
    <path d="M5 19.5C5.5 18 6 15 6 12c0-.7.12-1.37.34-2"/>
    <path d="M17.29 21.02c.12-.6.43-2.3.5-3.02"/>
    <path d="M12 10a2 2 0 0 0-2 2c0 1.02-.1 2.51-.26 4"/>
    <path d="M8.65 22c.21-.66.45-1.32.57-2"/>
    <path d="M14 13.12c0 2.38 0 6.38-1 8.88"/>
    <path d="M2 16h.01"/>
    <path d="M21.8 16c.2-2 .131-5.354 0-6"/>
    <path d="M9 6.8a6 6 0 0 1 9 5.2c0 .47 0 1.17-.02 2"/>`,
  // アクセス制御：何が見え，何を操作できるか
  'shield-check': `
    <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/>
    <path d="m9 12 2 2 4-4"/>`,
  // 暗号化・マスキング：データそのものを読めなくする
  lock: `
    <rect width="18" height="11" x="3" y="11" rx="2" ry="2"/>
    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>`,
  // 予備（運用・監査などに）
  'clipboard-check': `
    <rect width="8" height="4" x="8" y="2" rx="1" ry="1"/>
    <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>
    <path d="m9 14 2 2 4-4"/>`,
};
---

<svg
  class="section-icon"
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  set:html={ICONS[name]}
/>

<style>
  .section-icon {
    display: inline-block;
    width: 0.9em;
    height: 0.9em;
    vertical-align: -0.09em;
    margin-inline-end: 0.5em;
    color: var(--sl-color-text-accent);
    flex-shrink: 0;
  }
</style>
